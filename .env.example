# AdsPower Local API
ADSPOWER_BASE_URL=http://local.adspower.net:50325
ADSPOWER_API_KEY=

# Multilogin X launcher API (alternative driver, config: antidetect.driver = "multilogin")
MULTILOGIN_BASE_URL=https://launcher.mlx.yt:45001
# Multilogin X account credentials (launcher calls need a Bearer token from cloud signin)
MULTILOGIN_EMAIL=
MULTILOGIN_PASSWORD=
# Multilogin folder id that holds the PBD profiles (optional — first folder is used when empty)
MULTILOGIN_FOLDER_ID=
# Shared proxy upstream for the profile pool (config/profiles.json carries per-profile usernames)
MULTILOGIN_PROXY_HOST=
MULTILOGIN_PROXY_PORT=
MULTILOGIN_PROXY_PASSWORD=

# Captcha solvers (optional — SERP /sorry recovery)
TWOCAPTCHA_API_KEY=
CAPSOLVER_API_KEY=

# Panel login (defaults: admin / pbd)
PANEL_USER=admin
PANEL_PASSWORD=pbd
PANEL_PORT=3080

# Runtime
OUTPUT_DIR=./data
LOG_LEVEL=info
